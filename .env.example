# Copy to .env and fill in. .env is git-ignored and read-blocked for Claude.

# Replaceable components — selected by config (see CLAUDE.md)
LLM_PROVIDER=mock        # mock | gemini
STORAGE=local            # local | oci

# Local persistence
DATA_DIR=./backend/data

# Gemini (only when LLM_PROVIDER=gemini) — see docs/plans/gemini-integration.md
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OCI Object Storage (only when STORAGE=oci) — see docs/plans/oci-bucket-integration.md
OCI_NAMESPACE=
OCI_BUCKET=
OCI_REGION=

# API
CORS_ALLOW_ORIGINS=http://localhost:5500
